    "settings.picture.footer" : {
      "comment" : "Settings: footnote under the buffer picker",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard keeps the picture smooth and buffers only as much as your network needs. Low Latency shows frames sooner but stutters when Wi-Fi is uneven."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“标准”画面流畅，只按网络需要缓冲；“低延迟”画面更快，但 Wi-Fi 不稳时会卡顿。"
          }
        }
      }
    },
    "settings.picture.header" : {
      "comment" : "Settings: header of the picture section",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picture"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面"
          }
        }
      }
    },
    "settings.picture.statistics" : {
      "comment" : "Settings: toggle that shows stream statistics over the picture",
