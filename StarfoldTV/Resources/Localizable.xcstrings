        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV「设置 → 遥控器与设备 → 蓝牙」中配对手柄。"
          }
        }
      }
    },
    "controller.missing.title" : {
