    "controller.missing.instructions" : {
      "comment" : "How to pair a game controller, shown in the controller prompt, over the stream and in Settings when none is connected",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair a controller in Apple TV Settings > Remotes and Devices > Bluetooth."
