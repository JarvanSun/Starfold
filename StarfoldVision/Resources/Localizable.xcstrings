    "settings.picture.buffer" : {
      "comment" : "Settings picture section: picker for how much the stream buffers for smoothness",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buffer"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓冲"
          }
        }
      }
