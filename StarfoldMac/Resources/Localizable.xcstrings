    "settings.picture.toneMapping.detail" : {
      "comment" : "Settings, Picture: explanation under the HDR tone mapping toggle",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreads the stream over your display’s HDR brightness for brighter highlights. The stream itself is SDR, so this is not native HDR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把画面映射到显示器的 HDR 亮度，高光更亮。原始画面是 SDR，所以这不是原生 HDR。"
          }
        }
      }
    },
