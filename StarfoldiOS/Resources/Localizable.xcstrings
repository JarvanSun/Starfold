    "home.console.wakeUnavailable" : {
      "comment" : "Home: tooltip of the disabled wake button of a console in Energy-saving mode",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote wake needs Power mode set to Sleep. Turn the console on by hand, then press Play."
