        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程唤醒需要把电源模式设为“睡眠”。请手动开机后再点“开始游戏”。"
          }
        }
      }
    },
    "home.console.wirelessHint" : {
